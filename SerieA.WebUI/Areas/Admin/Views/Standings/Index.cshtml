@model List<SerieA.WebUI.Areas.Admin.Models.StandingViewModel>

@{
    ViewData["Title"] = "Puan Durumu";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">🏆 Serie A Puan Durumu</h2>
            <p class="text-muted mb-0">Tamamlanan maçlara göre güncel lig sıralaması</p>
        </div>

        <a asp-area="Admin"
           asp-controller="Standings"
           asp-action="Index"
           class="btn btn-outline-primary">
            <i class="bi bi-arrow-clockwise"></i> Yenile
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="text-center">Sıra</th>
                            <th>Takım</th>
                            <th class="text-center">O</th>
                            <th class="text-center">G</th>
                            <th class="text-center">B</th>
                            <th class="text-center">M</th>
                            <th class="text-center">AG</th>
                            <th class="text-center">YG</th>
                            <th class="text-center">AV</th>
                            <th class="text-center">P</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model == null || Model.Count == 0)
                        {
                            <tr>
                                <td colspan="10" class="text-center py-5 text-muted">
                                    Henüz puan durumu verisi bulunmuyor.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var team in Model.OrderBy(t => t.Position))
                            {
                                <tr>
                                    <td class="text-center fw-bold">@team.Position</td>

                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <a asp-area="Admin"
                                               asp-controller="Teams"
                                               asp-action="Details"
                                               asp-route-id="@team.TeamId"
                                               class="team-detail-link standings-team-link">

                                                @if (!string.IsNullOrWhiteSpace(team.LogoUrl))
                                                {
                                                    <img src="@team.LogoUrl"
                                                         alt="@team.TeamName"
                                                         style="width:30px;height:30px;object-fit:contain;" />
                                                }
                                                else
                                                {
                                                    <i class="bi bi-shield-fill text-secondary fs-4"></i>
                                                }

                                                <span class="fw-semibold">@team.TeamName</span>
                                            </a>
                                        </div>
                                    </td>

                                    <td class="text-center">@team.Played</td>
                                    <td class="text-center">@team.Won</td>
                                    <td class="text-center">@team.Drawn</td>
                                    <td class="text-center">@team.Lost</td>
                                    <td class="text-center">@team.GoalsFor</td>
                                    <td class="text-center">@team.GoalsAgainst</td>
                                    <td class="text-center">
                                        <span class="@(team.GoalDifference > 0 ? "text-success" : team.GoalDifference < 0 ? "text-danger" : "")">
                                            @(team.GoalDifference > 0 ? "+" : "")@team.GoalDifference
                                        </span>
                                    </td>
                                    <td class="text-center fw-bold fs-5">@team.Points</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="text-muted small mt-3">
        O: Oynanan · G: Galibiyet · B: Beraberlik · M: Mağlubiyet ·
        AG: Atılan Gol · YG: Yenen Gol · AV: Averaj · P: Puan
    </div>
</div>
