@model SerieA.WebUI.Models.TeamDetailViewModel

@{
    ViewData["Title"] = $"{Model.Name} - Takım Detayı";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var matches = Model.Matches ?? new List<SerieA.WebUI.Models.TeamMatchViewModel>();

    var lastFiveMatches = matches
        .Where(m => m.Status == "Finished"
                 && m.HomeScore.HasValue
                 && m.AwayScore.HasValue)
        .OrderByDescending(m => m.MatchDate)
        .Take(5)
        .ToList();
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">@Model.Name</h2>
            <p class="text-muted mb-0">Takım detayları ve lig performansı</p>
        </div>

        <a asp-area="Admin"
           asp-controller="Teams"
           asp-action="Index"
           class="btn btn-outline-secondary">
            ← Takım Listesine Dön
        </a>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body d-flex align-items-center gap-4">
            @if (!string.IsNullOrWhiteSpace(Model.LogoUrl))
            {
                <img src="@Model.LogoUrl"
                     alt="@Model.Name logosu"
                     style="width:100px;height:100px;object-fit:contain;" />
            }

            <div>
                <h3>@Model.Name</h3>

                @if (!string.IsNullOrWhiteSpace(Model.City))
                {
                    <p class="mb-1">📍 @Model.City</p>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Stadium))
                {
                    <p class="mb-0">🏟️ @Model.Stadium</p>
                }
            </div>
        </div>
    </div>

    <h4 class="mb-3">Lig İstatistikleri</h4>

    <div class="row g-3 mb-4">
        <div class="col-6 col-md-4 col-xl-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted">Lig Sırası</div>
                    <h3 class="mb-0">@(Model.Position > 0 ? Model.Position.ToString() : "-")</h3>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-4 col-xl-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted">Puan</div>
                    <h3 class="mb-0 text-success">@Model.Points</h3>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-4 col-xl-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted">Oynanan Maç</div>
                    <h3 class="mb-0">@Model.Played</h3>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-4 col-xl-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted">Galibiyet</div>
                    <h3 class="mb-0 text-success">@Model.Won</h3>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-4 col-xl-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted">Beraberlik</div>
                    <h3 class="mb-0">@Model.Drawn</h3>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-4 col-xl-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted">Mağlubiyet</div>
                    <h3 class="mb-0 text-danger">@Model.Lost</h3>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-4 col-xl-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted">Atılan Gol</div>
                    <h3 class="mb-0">@Model.GoalsFor</h3>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-4 col-xl-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted">Yenilen Gol</div>
                    <h3 class="mb-0">@Model.GoalsAgainst</h3>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-4 col-xl-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted">Averaj</div>
                    <h3 class="mb-0 @(Model.GoalDifference > 0 ? "text-success" : Model.GoalDifference < 0 ? "text-danger" : "")">
                        @(Model.GoalDifference > 0 ? "+" : "")@Model.GoalDifference
                    </h3>
                </div>
            </div>
        </div>
    </div>

    <h4 class="mb-3">Son 5 Maç Formu</h4>

    @if (lastFiveMatches.Any())
    {
        <div class="list-group mb-4">
            @foreach (var match in lastFiveMatches)
            {
                var isHome = match.HomeTeamId == Model.Id;

                var teamScore = isHome
                ? match.HomeScore!.Value
                : match.AwayScore!.Value;

                var opponentScore = isHome
                ? match.AwayScore!.Value
                : match.HomeScore!.Value;

                var opponentName = isHome
                ? match.AwayTeamName
                : match.HomeTeamName;

                var result = teamScore > opponentScore
                ? "G"
                : teamScore == opponentScore ? "B" : "M";

                var resultClass = result == "G"
                ? "bg-success"
                : result == "B" ? "bg-warning text-dark" : "bg-danger";

                <div class="list-group-item d-flex align-items-center gap-3">
                    <span class="badge @resultClass fs-6">@result</span>

                    <div class="flex-grow-1">
                        <strong>@opponentName</strong>
                        <div class="text-muted small">
                            @match.MatchDate.ToString("dd.MM.yyyy")
                        </div>
                    </div>

                    <strong>@teamScore - @opponentScore</strong>
                </div>
            }
        </div>
    }
    else
    {
        <p class="text-muted mb-4">Henüz tamamlanmış maç bulunmuyor.</p>
    }

    <h4 class="mb-3">Maç Fikstürü</h4>

    @if (matches.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Hafta</th>
                        <th>Tarih</th>
                        <th>Ev Sahibi</th>
                        <th>Skor</th>
                        <th>Deplasman</th>
                        <th>Durum</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var match in matches.OrderBy(m => m.MatchDate))
                    {
                        <tr>
                            <td>@match.Week. Hafta</td>
                            <td>@match.MatchDate.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>@match.HomeTeamName</td>
                            <td>
                                @if (match.HomeScore.HasValue && match.AwayScore.HasValue)
                                {
                                    <strong>@match.HomeScore - @match.AwayScore</strong>
                                }
                                else
                                {
                                    <span>VS</span>
                                }
                            </td>
                            <td>@match.AwayTeamName</td>
                            <td>
                                @if (match.Status == "Finished")
                                {
                                    <span class="badge bg-success">Tamamlandı</span>
                                }
                                else if (match.Status == "Live" || match.Status == "InProgress")
                                {
                                    <span class="badge bg-danger">Canlı</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Başlamadı</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="text-muted">Bu takım için kayıtlı maç bulunamadı.</p>
    }
</div>
