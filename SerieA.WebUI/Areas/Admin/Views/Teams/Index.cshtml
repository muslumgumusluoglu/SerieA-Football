@model List<SerieA.WebUI.Areas.Admin.Models.TeamViewModel>

@{
    ViewData["Title"] = "Takım Yönetimi";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-head">
    <div>
        <h2 class="page-title">Takım Yönetimi</h2>
        <p class="page-desc">
            Serie A takımlarını görüntüleyin.
        </p>
    </div>

    <div class="d-flex align-items-center gap-3">
        <span class="badge text-bg-primary">
            Toplam @Model.Count takım
        </span>

        <a href="/Admin/Teams/Create" class="btn btn-primary">
            + Yeni Takım Ekle
        </a>
    </div>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<div class="card-a">
    <div class="table-responsive">
        <table class="table-a">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Logo</th>
                    <th>Takım Adı</th>
                    <th>İşlemler</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var team in Model)
                {
                    <tr>
                        <td>@team.Id</td>

                        <td>
                            @if (!string.IsNullOrWhiteSpace(team.LogoUrl))
                            {
                                <img src="@team.LogoUrl"
                                     alt="@team.Name logosu"
                                     class="team-logo" />
                            }
                            else
                            {
                                <span class="text-muted">Logo yok</span>
                            }
                        </td>

                        <td>
                            <strong>@team.Name</strong>
                        </td>

                        <td>
                            <a href="/Admin/Teams/Details/@team.Id"
                               class="btn btn-info btn-sm">
                                Detay
                            </a>

                            <a href="/Admin/Teams/Edit/@team.Id"
                               class="btn btn-primary btn-sm">
                                Düzenle
                            </a>

                            <form action="/Admin/Teams/Delete/@team.Id"
                                  method="post"
                                  style="display:inline;">

                                @Html.AntiForgeryToken()

                                <button type="button"
                                        class="btn btn-danger btn-sm"
                                        data-team-name="@team.Name"
                                        onclick="openDeleteModal(this)">
                                    Sil
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Takım Silme Modalı -->
<div id="deleteTeamModal"
     class="delete-modal-overlay"
     style="display: none;">

    <div class="delete-modal">
        <div class="delete-modal-icon">
            <span>!</span>
        </div>

        <h3>Takımı Sil</h3>

        <p>
            <strong id="deleteTeamName"></strong>
            takımını silmek istediğine emin misin?
        </p>

        <p class="delete-modal-warning">
            Bu işlem geri alınamaz.
        </p>

        <div class="delete-modal-actions">
            <button type="button"
                    class="delete-cancel-btn"
                    onclick="closeDeleteModal()">
                Vazgeç
            </button>

            <button type="button"
                    class="delete-confirm-btn"
                    onclick="confirmDeleteTeam()">
                Evet, Takımı Sil
            </button>
        </div>
    </div>
</div>

<script>
    let deleteTeamForm = null;

    function openDeleteModal(button) {
        deleteTeamForm = button.closest("form");

        const teamName = button.dataset.teamName;

        document.getElementById("deleteTeamName").textContent = teamName;
        document.getElementById("deleteTeamModal").style.display = "flex";

        document.body.style.overflow = "hidden";
    }

    function closeDeleteModal() {
        document.getElementById("deleteTeamModal").style.display = "none";
        document.body.style.overflow = "";

        deleteTeamForm = null;
    }

    function confirmDeleteTeam() {
        if (deleteTeamForm) {
            deleteTeamForm.submit();
        }
    }

    document.getElementById("deleteTeamModal").addEventListener("click", function (event) {
        if (event.target === this) {
            closeDeleteModal();
        }
    });

    document.addEventListener("keydown", function (event) {
        if (event.key === "Escape") {
            closeDeleteModal();
        }
    });
</script>
