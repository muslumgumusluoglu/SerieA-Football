
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Serie A Yönetim</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&family=Barlow+Condensed:wght@500;600;700&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/admin.css"
          asp-append-version="true" />
</head>

<body class="admin-page">

    <aside class="admin-sidebar">
        <a asp-area="Admin"
           asp-controller="Dashboard"
           asp-action="Index"
           class="sidebar-brand">
            <span class="brand-mark">SA</span>
            <span>Serie A <small>YÖNETİM PANELİ</small></span>
        </a>

        <nav class="sidebar-nav">
            <div class="sidebar-section-title">ANA MENÜ</div>


            <a asp-area="Admin"
               asp-controller="Dashboard"
               asp-action="Index"
               class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "is-active" : "")">
                <span>⌂</span> Ana Sayfa
            </a>


            <a asp-area="Admin"
               asp-controller="Matches"
               asp-action="Index"
               class="sidebar-link">
                <span>⚽</span> Maçlar
            </a>





            <a asp-area="Admin"
               asp-controller="Fixtures"
               asp-action="Index"
               class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Fixtures" ? "is-active" : "")">
                <span>📅</span> Fikstür
            </a>





            <a asp-area="Admin"
               asp-controller="Teams"
               asp-action="Index"
               class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Teams" ? "is-active" : "")">
                <span>🛡</span> Takımlar
            </a>


            <a asp-area="Admin"
               asp-controller="Standings"
               asp-action="Index"
               class="sidebar-link">
                <span>▤</span>
                Puan Durumu
            </a>


        </nav>

        <div class="sidebar-footer">
            <span>Serie A</span>
            <small>Futbol Yönetim Sistemi</small>
        </div>
    </aside>

    <div class="admin-main">
        <header class="admin-topbar">
            <div class="topbar-left">
                <div class="topbar-crumb">SERIE A / YÖNETİM</div>
                <h1 class="topbar-title">@ViewData["Title"]</h1>
            </div>

            <div class="topbar-right">
                <span class="admin-status">● Sistem hazır</span>
            </div>
        </header>

        <main class="admin-content">
            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/admin.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
