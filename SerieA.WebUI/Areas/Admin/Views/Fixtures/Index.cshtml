@model List<SerieA.WebUI.Areas.Admin.Models.MatchViewModel>

@{
    ViewData["Title"] = "Fikstür";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    int seciliHafta = ViewBag.Week ?? 1;
}

<div class="container-fluid py-3">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">📅 Serie A Fikstür</h2>
            <p class="text-muted mb-0">Haftalara göre maç programı ve sonuçlar</p>
        </div>

        <a asp-area="Admin"
           asp-controller="Fixtures"
           asp-action="Index"
           asp-route-week="@seciliHafta"
           class="btn btn-outline-primary">
            <i class="bi bi-arrow-clockwise"></i> Yenile
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form asp-area="Admin"
                  asp-controller="Fixtures"
                  asp-action="Index"
                  method="get"
                  class="d-flex align-items-center flex-wrap gap-3">

                <label for="week" class="fw-semibold">Hafta seç:</label>

                <select id="week"
                        name="week"
                        class="form-select"
                        style="width:160px;"
                        onchange="this.form.submit()">
                    @for (int hafta = 1; hafta <= 38; hafta++)
                    {
                        if (hafta == seciliHafta)
                        {
                            <option value="@hafta" selected>@hafta. Hafta</option>
                        }
                        else
                        {
                            <option value="@hafta">@hafta. Hafta</option>
                        }
                    }
                </select>

                <button type="submit" class="btn btn-primary">
                    Göster
                </button>
            </form>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold mb-0">@seciliHafta. Hafta Maçları</h4>

        <div class="btn-group">

            <div class="d-flex gap-2">
                <a asp-area="Admin"
                   asp-controller="Fixtures"
                   asp-action="Index"
                   asp-route-week="@(seciliHafta > 1 ? seciliHafta - 1 : 1)"
                   class="btn btn-outline-primary"
                   title="Önceki hafta">
                    <i class="bi bi-chevron-left"></i>
                    Önceki
                </a>

                <a asp-area="Admin"
                   asp-controller="Fixtures"
                   asp-action="Index"
                   asp-route-week="@(seciliHafta < 38 ? seciliHafta + 1 : 38)"
                   class="btn btn-outline-primary"
                   title="Sonraki hafta">
                    Sonraki
                    <i class="bi bi-chevron-right"></i>
                </a>
            </div>

        </div>
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-calendar-x fs-1 text-muted"></i>
                <h5 class="mt-3">Bu haftada maç bulunamadı</h5>
                <p class="text-muted mb-0">
                    Maçlar menüsünden bu haftaya maç ekleyebilirsin.
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var match in Model.OrderBy(m => m.MatchDate))
            {
                var durum = match.Status switch
                {
                    "Finished" => "Tamamlandı",
                    "Live" => "Canlı",
                    "Postponed" => "Ertelendi",
                    _ => "Başlamadı"
                };

                var durumSinifi = match.Status switch
                {
                    "Finished" => "bg-success",
                    "Live" => "bg-danger",
                    "Postponed" => "bg-secondary",
                    _ => "bg-primary"
                };

                <div class="card border-0 shadow-sm">
                    <div class="card-body p-3 p-md-4">

                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                            <div class="text-muted small">
                                <i class="bi bi-calendar-event me-1"></i>
                                @match.MatchDate.ToString("dd.MM.yyyy HH:mm")
                                <span class="mx-2">|</span>
                                <i class="bi bi-geo-alt me-1"></i>
                                @match.Stadium
                            </div>

                            <span class="badge @durumSinifi">@durum</span>
                        </div>

                        <div class="row align-items-center text-center g-3">
                            <div class="col-5">
                                <div class="d-flex flex-column flex-md-row align-items-center justify-content-center gap-2">
                                    @if (!string.IsNullOrWhiteSpace(match.HomeTeamLogoUrl))
                                    {
                                        <img src="@match.HomeTeamLogoUrl"
                                             alt="@match.HomeTeamName"
                                             style="width:42px;height:42px;object-fit:contain;" />
                                    }

                                    <span class="fw-bold">@match.HomeTeamName</span>
                                </div>
                            </div>

                            <div class="col-2">
                                @if (match.HomeScore.HasValue && match.AwayScore.HasValue)
                                {
                                    <div class="fs-4 fw-bold">
                                        @match.HomeScore - @match.AwayScore
                                    </div>
                                }
                                else
                                {
                                    <div class="text-muted fw-semibold">VS</div>
                                }
                            </div>

                            <div class="col-5">
                                <div class="d-flex flex-column flex-md-row align-items-center justify-content-center gap-2">
                                    @if (!string.IsNullOrWhiteSpace(match.AwayTeamLogoUrl))
                                    {
                                        <img src="@match.AwayTeamLogoUrl"
                                             alt="@match.AwayTeamName"
                                             style="width:42px;height:42px;object-fit:contain;" />
                                    }

                                    <span class="fw-bold">@match.AwayTeamName</span>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-3 pt-3 border-top">
                            <a asp-area="Admin"
                               asp-controller="Matches"
                               asp-action="Details"
                               asp-route-id="@match.Id"
                               class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-eye me-1"></i> Maç Detayı
                            </a>

                            <a asp-area="Admin"
                               asp-controller="Matches"
                               asp-action="Edit"
                               asp-route-id="@match.Id"
                               class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-pencil me-1"></i> Düzenle
                            </a>
                        </div>

                    </div>
                </div>
            }
        </div>
    }

</div>
