@model List<SerieA.WebUI.Areas.Admin.Models.MatchViewModel>

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Maç Yönetimi";
    int selectedWeek = ViewBag.Week ?? 1;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">⚽ Maç Yönetimi</h2>
            <p class="text-muted mb-0">Serie A maçlarını görüntüle.</p>
        </div>

        <a href="/Admin/Matches/Create" class="btn btn-primary">
            + Yeni Maç Ekle
        </a>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form method="get" action="/Admin/Matches/Index"
                  class="d-flex align-items-center gap-3 flex-wrap">
                <label for="week" class="fw-semibold">Maç Haftası:</label>

                <select id="week" name="week"
                        class="form-select" style="max-width: 180px;"
                        onchange="this.form.submit()">
                    @for (int i = 1; i <= 38; i++)
                    {
                        if (i == selectedWeek)
                        {
                            <option value="@i" selected>@i. Hafta</option>
                        }
                        else
                        {
                            <option value="@i">@i. Hafta</option>
                        }
                    }
                </select>

                <noscript>
                    <button type="submit" class="btn btn-secondary">
                        Listele
                    </button>
                </noscript>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            @if (Model == null || !Model.Any())
            {
                <div class="text-center py-5">
                    <h5>Bu hafta için maç bulunamadı.</h5>
                    <p class="text-muted mb-0">
                        API bağlantısını ve seçilen haftayı kontrol edebilirsin.
                    </p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Tarih</th>
                                <th>Ev Sahibi</th>
                                <th class="text-center">Skor</th>
                                <th>Deplasman</th>
                                <th>Stadyum</th>
                                <th>Durum</th>
                                <th class="text-end">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var match in Model)
                            {
                                <tr>
                                    <td>
                                        @match.MatchDate.ToString("dd.MM.yyyy HH:mm")
                                    </td>

                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            @if (!string.IsNullOrWhiteSpace(match.HomeTeamLogoUrl))
                                            {
                                                <img src="@match.HomeTeamLogoUrl"
                                                     alt=""
                                                     style="width:30px;height:30px;object-fit:contain;" />
                                            }
                                            <span>@match.HomeTeamName</span>
                                        </div>
                                    </td>

                                    <td class="text-center fw-bold">
                                        @if (match.HomeScore.HasValue &&
                                                                        match.AwayScore.HasValue)
                                        {
                                            <span>
                                                @match.HomeScore - @match.AwayScore
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">- : -</span>
                                        }
                                    </td>

                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            @if (!string.IsNullOrWhiteSpace(match.AwayTeamLogoUrl))
                                            {
                                                <img src="@match.AwayTeamLogoUrl"
                                                     alt=""
                                                     style="width:30px;height:30px;object-fit:contain;" />
                                            }
                                            <span>@match.AwayTeamName</span>
                                        </div>
                                    </td>

                                    <td>@match.Stadium</td>

                                    <td>
                                        @switch (match.Status)
                                        {
                                            case "Finished":
                                                <span class="badge bg-success">Bitti</span>
                                                break;
                                            case "Live":
                                                <span class="badge bg-danger">Canlı</span>
                                                break;
                                            case "Postponed":
                                                <span class="badge bg-warning text-dark">Ertelendi</span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary">Başlamadı</span>
                                                break;
                                        }
                                    </td>


                                    <td class="text-end">
                                        <div class="d-flex justify-content-end gap-2">
                                            <a href="/Admin/Matches/Edit/@match.Id"
                                               class="btn btn-sm btn-outline-primary">
                                                Düzenle
                                            </a>

                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger"
                                                    onclick="macSilOnayiniAc(@match.Id, @match.Week, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(match.HomeTeamName))', '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(match.AwayTeamName))')">
                                                Sil
                                            </button>

                                            <a asp-area="Admin"
                                               asp-controller="Matches"
                                               asp-action="Details"
                                               asp-route-id="@match.Id"
                                               class="btn btn-sm btn-info text-white">
                                                Detay
                                            </a>
                                        </div>
                                    </td>

                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>


    <!-- Maç silme onay penceresi -->
    <div class="modal fade" id="macSilModal" tabindex="-1"
         aria-labelledby="macSilModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header">
                    <h5 class="modal-title" id="macSilModalLabel">
                        Maçı Sil
                    </h5>
                    <button type="button" class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Kapat"></button>
                </div>

                <div class="modal-body">
                    <p>Bu maçı silmek istediğine emin misin?</p>
                    <div class="alert alert-warning mb-0">
                        <strong id="silMatchName"></strong>
                        <p class="small mb-0 mt-1">
                            Bu işlem geri alınamaz.
                        </p>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary"
                            data-bs-dismiss="modal">
                        Vazgeç
                    </button>

                    <form method="post" action="/Admin/Matches/Delete">
                        @Html.AntiForgeryToken()
                        <input type="hidden" id="silMatchId" name="id" />
                        <input type="hidden" id="silMatchWeek" name="week" />

                        <button type="submit" class="btn btn-danger">
                            Evet, Maçı Sil
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script>
        function macSilOnayiniAc(id, week, homeTeam, awayTeam) {
            document.getElementById("silMatchId").value = id;
            document.getElementById("silMatchWeek").value = week;
            document.getElementById("silMatchName").textContent =
                homeTeam + " - " + awayTeam;

            const modalElement = document.getElementById("macSilModal");
            const modal = bootstrap.Modal.getOrCreateInstance(modalElement);
            modal.show();
        }
    </script>


</div>
